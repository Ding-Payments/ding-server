{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@noble/hashes/sha2\\.js$": "<rootDir>/mocks/noble-hashes-sha2.ts",
    "^@noble/ed25519$": "<rootDir>/mocks/noble-ed25519.ts",
    "^uint8array-extras$": "<rootDir>/mocks/uint8array-extras.ts",
    "^smol-toml$": "<rootDir>/mocks/smol-toml.ts"
  },
  "globalSetup": "<rootDir>/env.setup.ts"
}
