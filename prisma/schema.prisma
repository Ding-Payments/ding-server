generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// DATABASE_URL usa el pooler de Supabase (puerto 6543, pgbouncer=true)
// DIRECT_URL va directo a postgres (puerto 5432, sin pgbouncer)
// directUrl es requerido para que prisma migrate dev funcione

enum StellarNetwork {
  TESTNET
  MAINNET
}

enum AssetCode {
  XLM
  USDC
}

enum PaymentRequestStatus {
  CREATED
  SHARED
  EXPIRED
  CONSUMED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  SUBMITTED
  CONFIRMED
  FAILED
}

enum TransactionDirection {
  SENT
  RECEIVED
}

model User {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique
  email          String   @unique
  displayName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  wallets        Wallet[]

  @@map("users")
}

model Wallet {
  id               String         @id @default(uuid())
  userId           String
  stellarPublicKey String
  network          StellarNetwork
  isPrimary        Boolean        @default(false)
  label            String?
  createdAt        DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stellarPublicKey, network])
  @@index([userId, isPrimary])
  @@map("wallets")
}
